{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm lint:fix*)",
      "Bash(pnpm format*)",
      "Bash(pnpm format:fix*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm precommit*)",
      "Bash(pnpm --filter=* test*)",
      "Bash(pnpm --filter=* build*)",
      "Bash(pnpm --filter=* dev*)",
      "Bash(pnpm --filter=db db:*)",
      "Bash(pnpm biome *)",
      "Bash(turbo *)",
      "Bash(pnpm install*)",
      "Bash(npx biome check --write*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx biome check --write --unsafe $CLAUDE_FILE_PATHS 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
