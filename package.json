{
  "name": "svelte-hono-template",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:secrets": "infisical run --env=development --path=/api -- turbo run dev --filter=api & infisical run --env=development --path=/web -- turbo run dev --filter=web",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:secrets": "infisical run --env=production --path=/api -- turbo run test",
    "precommit": "pnpm lint && pnpm typecheck",
    "prepare": "husky",
    "generate:secrets": "bash scripts/generate-secrets.sh || powershell -ExecutionPolicy Bypass -File scripts/generate-secrets.ps1",
    "infisical:login": "infisical login",
    "infisical:init": "infisical init",
    "infisical:secrets": "infisical secrets --path=/api",
    "infisical:secrets:web": "infisical secrets --path=/web",
    "infisical:run": "infisical run --env=development --path=/api --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=18"
  }
}
